# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BONKU

# Optional: For production
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_keep_secret

# Guest/demo mode: run the whole app with seeded in-memory data and no
# Supabase project. Bypasses authentication, so it is ignored in production
# builds (see lib/demo/config.ts). Never rely on it for a public demo.
NEXT_PUBLIC_DEMO_MODE=false
